# Production Environment Variables
# Copy this to .env.production and fill in your values

# ===== Turso (libsql) - Required for Vercel deployment =====
# Get these from https://turso.tech → Create Database → Copy URL + Token
TURSO_DATABASE_URL="libsql://timezonehub-yourname.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# Fallback SQLite (not used when TURSO_* is set above)
DATABASE_URL="file:./prisma/prod.db"

# NextAuth - generate with: openssl rand -base64 32
AUTH_SECRET="7vTOGZFX76ec/vnr36LiGSjer9TCYZhoi1iu8hp6eeY="
AUTH_URL="https://yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="TimezoneHub"

# Ads (optional)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""

# Integrations (optional)
GOOGLE_MAPS_API_KEY=""
OPENWEATHER_API_KEY=""
MAILCHIMP_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
